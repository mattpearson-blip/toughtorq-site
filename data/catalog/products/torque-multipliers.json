  "features": [
    "Planetary gear train multiplies torque output",
    "Manual operation without hydraulic, pneumatic, or electric power",
    "Adjustable reaction foot for application flexibility",
    "Designed for large-diameter bolts and nuts",
    "Z Type models suit confined-space applications",
    "L Type models provide offset access",
    "Custom configurations available for application requirements"
  ],
  "applications": [
    "Industrial flange bolting",
    "Heavy equipment maintenance",
    "Structural bolting",
    "Large fastener installation",
    "Restricted-access bolting",
    "Field maintenance",
    "Equipment assembly",
    "Manual high-torque applications"
